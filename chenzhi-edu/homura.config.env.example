# 辰知教务 · homura 配置文件示例
#
# 复制为 homura.config.env 后按需修改。真实环境变量优先于本文件。
# @homurajs/core 的 applyEnvFile() 会在 defineConfig().load() 之前把它并入 process.env。
# 优先级：HOMURA_CONFIG_FILE → <cwd>/homura.config.env → QWENWORK_WRITABLE_DIR/homura.config.env

# ---- 运行形态 ----
# standalone（独立部署）或 qw-pages（平台动态页）；auto = 按注入标记自动探测
HOMURA_RUNTIME=auto
PORT=8787
HOST=127.0.0.1
# standalone 反代后置 1（决定 cookie Secure）；qw-pages 恒为 true
TRUST_PROXY=0

# ---- 持久层（@homurajs/db）----
# sqlite 形态：文件路径或 :memory:
DB_PATH=data/chenzhi.db
# pg 形态（可选，二选一）：置空则用 sqlite
DATABASE_URL=

# ---- 认证（@homurajs/auth）----
# HS256 会话密钥，>=32 字节，生产必须覆盖！
AUTH_SECRET=dev-only-change-me-please-32bytes-min
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
# 是否开放自助注册（演示建议开；生产可关，仅由种子管理员登录）
ALLOW_REGISTER=true

# ---- 授权（@homurajs/license）----
# 关闭后不挂 license 守卫（纯本地开发可关）
LICENSE_ENABLED=true
# 本地 genuine-mock 授权中心地址（tools/genuine-mock.ts）
GENUINE_SERVER=http://127.0.0.1:8790
GENUINE_PRODUCT_ID=chenzhi-edu
GENUINE_APP_ID=chenzhi-edu-app
GENUINE_LICENSE_KEY=
# 中心 Ed25519 公钥 PEM（配了才验签；scripts/genkeys.ts 生成）
GENUINE_PUBLIC_KEY=

# ---- 对象存储（@homurajs/storage）----
STORAGE_DIR=data/storage

# ---- 日志（@homurajs/core）----
LOG_LEVEL=info

# ---- 演示种子账号（scripts/seed.ts）----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=chenzhi@2025
SEED_ADMIN_NICKNAME=教务管理员
