{
  "name": "guga-timetable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Guga 课务 · 教务管理系统（基于 @homurajs 全家桶 + Vite8/React19/shadcn(TW3)）",
  "engines": {
    "node": ">=22.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm run dev:server -w @guga/server\" \"npm run dev:web -w @guga/web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:genuine": "tsx tools/genuine-mock.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "preview": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "genkeys": "tsx scripts/genkeys.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/server/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}